{
  "expo": {
    "name": "BLE Scale",
    "slug": "ble-scale-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4A90D9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blescale.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "L'app necessita del Bluetooth per connettersi alla bilancia.",
        "NSBluetoothPeripheralUsageDescription": "L'app necessita del Bluetooth per connettersi alla bilancia."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A90D9"
      },
      "package": "com.blescale.app",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"]
        }
      ]
    ]
  }
}
